{
  "name": "dusk",
  "private": true,
  "version": "2.0.0",
  "description": "DUSK — offline-first gothic task journal (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:portable": "vite build && node scripts/build-portable.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "gates": "npm run gate:test && npm run gate:types && npm run gate:build && npm run gate:icons && npm run gate:e2e",
    "gate:test": "vitest run",
    "gate:types": "node scripts/tsc-baseline.mjs",
    "gate:build": "vite build",
    "gate:icons": "node scripts/icon-inventory.mjs",
    "gate:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "idb-keyval": "^6.2.6",
    "sortablejs": "^1.15.2"
  }
}
